MODEL_PATH=/home/user/Desktop/AI/AI-CHAT/models
DB_DIR=./rag_system/db
LOG_DIR=./rag_system/logs
# API_KEY: 환경변수에서 읽거나, 아래에서 직접 설정
# 보안: 32자 이상 강력한 키 사용, Git 커밋 금지!
API_KEY=weKiC8kcLrYyrkRZS2zTYEgFKEZREN1U09RAzrB7pAI
STREAMLIT_SERVER_PORT=8501

# 메타데이터 DB 경로 (sqlite_helpers.py 전용)
METADB_PATH=./metadata.db

# ============================================================================
# Chat Format 설정
# ============================================================================
# auto: GGUF 메타데이터의 tokenizer.chat_template 자동 사용 (권장)
# 강제 지정: llama-2, chatml, qwen, zephyr 등
CHAT_FORMAT=auto

# ============================================================================
# API 공개 URL (선택적 - WSL/외부 접속 환경에서 설정)
# ============================================================================
# PUBLIC_API_BASE=http://192.168.0.10:7860
# 설정하지 않으면 FastAPI가 Request 헤더에서 자동 추출

# CPU 최적화 (Intel Xeon Silver 4410Y - 16코어/32스레드)
N_THREADS=20
PARALLEL_WORKERS=20  # 10 → 20 (H100 워크스테이션 CPU 활용)

# GPU 최적화 (H100 PCIe 80GB)
N_GPU_LAYERS=-1
MAIN_GPU=0
F16_KV=true
LOW_VRAM=false

# 컨텍스트 및 배치 크기 (GPU 모드 - H100 최적화)
N_CTX=4096
N_BATCH=1536  # 768 → 1536 (H100 처리량 향상)
MAX_DOCUMENTS_TO_PROCESS=20
MAX_PAGES_PER_PDF=50
BATCH_SIZE=10

# 캐싱
CACHE_MAX_SIZE=1000
RESPONSE_CACHE_TTL=7200

# 성능 모드
ENVIRONMENT=production
DEBUG_MODE=false

# 로깅 설정 (2025-12-23: 유지보수용 상세 로그)
LOG_LEVEL=DEBUG

# ============================================================================
# 검색 설정 (운영 최적화 값 - 2025-10-30 튜닝)
# ============================================================================
# 검색 후보/표시 수 분리 (2025-11-10: "19건 중 1건" 버그 근본 해결)
RETRIEVE_TOPK=200          # 백엔드 검색 후보 수 (필터링 전)
DISPLAY_LIMIT=20           # 프론트엔드 표시 개수 (필터링 후)
SEARCH_TOP_K=5             # DEPRECATED: RETRIEVE_TOPK/DISPLAY_LIMIT로 대체 예정
# 검색 가중치 (2025-12-08: 의미 검색 강화로 관련 문서 추천 개선)
SEARCH_VECTOR_WEIGHT=0.20  # 0.05 → 0.20 (의미 검색 4배 강화)
SEARCH_BM25_WEIGHT=0.80    # 0.95 → 0.80 (BM25 비중 조정)
DEFAULT_THRESHOLD=0.20

# ============================================================================
# V2 Retriever Settings (신규 2-layer RAG 아키텍처) - DEPRECATED (2025-10-26)
# ============================================================================
USE_V2_RETRIEVER=false  # V2는 더 이상 지원되지 않음, v1 사용
INDEX_VERSION=v1        # 인덱스 버전 (v2는 archive로 이동됨)

# V2 Index Paths (하드코딩 방지, .env 값만 사용)
# 2025-11-01: BM25 경로 업데이트 (전체 텍스트 인덱스 사용)
RETRIEVER_BACKEND=bm25  # bm25: 전체 텍스트 검색 | metadata: 폴백 모드 (500자 제한)
BM25_INDEX_PATH=var/index/bm25_index.pkl
BM25_IDF_MODE=adaptive  # adaptive: 적응형 IDF (고빈도 토큰 페널티) | clipped: 기본 클리핑 | rsj: 순수 RSJ
DOC_ANCHORED_ENABLED=true  # DOC_ANCHORED 모드 활성화 (장비 질의 필터링)
VECTOR_INDEX_PATH=./indexes_v2/faiss
METADATA_DB_PATH=./metadata.db
EXTRACTED_DIR=data/extracted  # 전체 텍스트 보강용 디렉토리

# DOC_ANCHORED 모드 설정 (2025-11-01: 단일 문서 앵커)
ROUTER_FORCE_DOC_TOP1_MIN=15.0  # Top-1 최소 점수
ROUTER_FORCE_DOC_DELTA12_MIN=3.0  # Top-1 vs Top-2 최소 차이
ROUTER_FORCE_DOC_RATIO12_MIN=1.35  # Top-1/Top-2 최소 비율
DOC_ANCHOR_MIN_SNIPPET=1200  # 스니펫 최소 길이 (부족 시 extracted에서 보강)

# Search Parameters
SEARCH_BM25_TOP_K=20   # BM25 검색 개수 (RRF 융합 전)
SEARCH_VEC_TOP_K=20    # Vector 검색 개수 (RRF 융합 전)
SEARCH_RRF_K=60        # RRF constant (기본 60, 높을수록 precision 증가)

# Metadata Fusion (메타데이터 검색 병합)
ENABLE_METADATA_FUSION=true   # 메타데이터 검색 활성화
METADATA_FUSION_WEIGHT=0.6    # 메타데이터 검색 가중치
HYBRID_FUSION_WEIGHT=0.4      # 하이브리드 검색 가중치
FUSION_TOP_K=5                # 최종 융합 결과 개수

# 임베딩 모델 (H100 환경 - 대용량 다국어 모델)
EMBEDDING_MODEL=intfloat/multilingual-e5-large  # 1024-dim (기존: jhgan/ko-sroberta-multitask 768-dim)

# ============================================================================
# 진단 모드 (Diagnostic Mode)
# ============================================================================
DIAG_RAG=true              # RAG 파이프라인 진단 활성화 (true/false)
DIAG_LOG_LEVEL=DEBUG       # 진단 로그 레벨 (DEBUG/INFO/WARNING) - 유지보수용 상세

# ============================================================================
# LLM 설정 (vLLM with Qwen2.5-72B-Instruct-AWQ on H100)
# ============================================================================
LLM_ENABLED=true  # LLM 활성화 (true=켜짐, false=꺼짐)
LLM_BACKEND=vllm  # vllm: vLLM 엔진 (H100 최적화, 배치 처리)
LLM_MODEL_PATH=/home/user/Desktop/AI/AI-CHAT/models
VLLM_MODEL_PATH=/home/user/Desktop/AI/AI-CHAT/models
LLM_N_CTX=16384  # 컨텍스트 길이 (8192 → 16384, H100 대용량 컨텍스트)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096  # 최대 토큰 (3072 → 4096)
MAX_LLM_RETRY=1  # LLM 생성 재시도 횟수 (운영: 1회)

# vLLM 전용 설정 (H100 80GB 최적화 - 2025-12-21 성능 튜닝)
VLLM_WORKER_MULTIPROC_METHOD=spawn  # CUDA fork 충돌 방지 (필수)
VLLM_GPU_MEMORY_UTILIZATION=0.90  # GPU 메모리 활용률 (85% → 90%, 72GB 사용)
VLLM_MAX_MODEL_LEN=32768  # 최대 모델 길이 (16384 → 32768, 2배 확장)
VLLM_TENSOR_PARALLEL_SIZE=1  # 텐서 병렬화 크기 (단일 H100)
VLLM_TRUST_REMOTE_CODE=true  # 원격 코드 신뢰 (Qwen 모델용)
VLLM_ENABLE_PREFIX_CACHING=true  # 프롬프트 캐싱 활성화 (반복 쿼리 가속)
VLLM_ENFORCE_EAGER=false  # CUDA 그래프 활성화 (false=성능↑, true=안정성↑)

# Flash Attention 최적화 (3단계 - H100 메모리 절약)
ENABLE_FLASH_ATTENTION=true  # Flash Attention 2 활성화 (메모리 30% 절약)
ENABLE_KV_CACHE_QUANTIZATION=false  # KV 캐시 양자화 (vLLM 전용, 추후 활성화)
KV_CACHE_DTYPE=fp8  # KV 캐시 데이터 타입 (fp8: 메모리 50% 절약)

# 기존 llama-cpp 설정 (백업용, 비활성)
# LLM_BACKEND=llama_cpp
# QWEN_MODEL_PATH=/home/wnstn4647/AI-CHAT/models/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
# LLM_N_THREADS=28
# LLM_N_GPU_LAYERS=32
# LLM_N_BATCH=512

# ============================================================================
# 운용 모드 설정 (2025-10-30) - 일반 대화 vs 문서근거 자동 전환
# ============================================================================
MODE=AUTO  # AUTO: 점수 기반 자동 전환 | SUMMARIZE: 문서 요약 전용 | CHAT: 일반 대화 전용
RAG_MIN_SCORE=0.45  # 문서근거 모드 최소 점수 (0.35 → 0.45, 저품질 문서 필터링 강화)
DOC_TOPK=1  # 문서근거 모드에서 사용할 상위 문서 개수 (2→1, 지연 축소)
REQUIRE_CITATIONS=true  # 출처 인용 필수 (true일 때 출처 누락 시 재시도)
ALLOW_UNGROUNDED_CHAT=true  # 일반 대화 허용 (false면 항상 문서근거만)

# 라우팅 정책 (2025-10-30 절대값 기반 게이팅 + Coverage Gate)
RAG_MIN_SCORE_POLICY=absolute  # absolute: 절대값 임계값 | normalized: 정규화 점수
BM25_MIN_ABS=5.0               # BM25 절대값 최소 임계값
VEC_MIN_ABS=0.40               # Vector 코사인 절대값 최소 임계값 (0.25 → 0.40)
MIN_KEYWORD_COVERAGE=1         # 최소 키워드 커버리지 (검색 결과에서 발견된 키워드 개수)

# === 모드별 토큰 예산 (2025-12-23 통합 정리) ===
# Single Source of Truth: 모든 토큰 설정은 여기서 관리
# adapters.py의 MODE_TOKEN_BUDGETS, constants.py의 LLMConfig와 동기화됨
CHAT_MAX_TOKENS=1024           # 스몰토크/일반 질의 (예상: ~3-5s)
RAG_MAX_TOKENS=4096            # 근거 인용형 답변 (예상: ~12-15s)
DETAILED_MAX_TOKENS=8192       # 자세히 모드 - H100 최대 활용 (긴 문서 상세 설명)
SUMMARIZE_MAX_TOKENS=2048      # 요약 모드
SUMMARY_MAX_TOKENS=2048        # 요약 라우팅용 (adapters.py "summary" 모드)
LLM_MAX_TOKENS_SUMMARY=2048    # 요약 라우팅용 (레거시 호환)
YEAR_SUMMARY_MAX_TOKENS=4096   # 연도별 다중 문서 요약
SUMMARIZE_PROMPT_BUDGET=900    # 요약 프롬프트 컨텍스트 예산 (토큰)

# 답변 스타일 (2025-12-08: 압축 비활성화로 맥락 손실 방지)
RAG_STYLE_COMPACT=false        # true → false (상세한 답변 허용)
RESPONSE_SENTENCE_CAP=15        # 문장 수 상한 - 더 상세한 답변 허용

# 컨텍스트 최적화 (입력측 토큰 절감)
CONTEXT_MAX_TOKENS=1200        # 프롬프트 컨텍스트 상한 (토큰 단위)
CHUNK_MERGE_MIN_TOKENS=200     # 과분절 합치기
SNIPPET_MAX_LENGTH=3600        # 스니펫 최대 길이 (3600자 = ~1200 토큰, 3배 증가)

# ============================================================================
# Context Hydrator 설정 (2025-11-12: 보안·성능·관측성 강화)
# ============================================================================
# 토큰↔문자 변환 계수 (모델별 편차 고려)
# - 기본값 0.33: 1 char ≈ 0.33 token (즉, 1 token ≈ 3 chars)
# - 영문 위주 모델: 0.25 권장
# - 한글/일본어 모델: 0.33 ~ 0.40 권장
TOKENS_PER_CHAR=0.33

# PDF 보강 설정
DOCS_DIR=docs                  # PDF 파일 루트 디렉토리 (보안 경로 검증 기준)
PDF_TAIL_PAGE_COUNT=2          # PDF 테일 추출 페이지 수 (기본 2, 마지막 N페이지)
MAX_PDF_SIZE_MB=64             # PDF 파일 최대 크기 (MB, 보안 제한)

# 문장 스코어링 휴리스틱 가중치 (2025-11-12: 파라미터화)
HYDRATOR_W_NUMERIC=3           # 수치 정보 가중치 (금액/날짜/수량)
HYDRATOR_W_KEYWORD=1           # 도메인 키워드 가중치
HYDRATOR_W_CONCLUSION=2        # 결론/요약 마커 가중치
HYDRATOR_W_EDGE=1              # 서두/말미 가중치
IGNORE_SEMVER_IN_NUMERIC=false # 세미버(v1.2.3) 패턴을 수치 가중에서 제외 (과다 반영 방지)
END_BONUS=1                    # 말미 가중치 활성화 (0=비활성, 1=활성)

# 품질 가드
ENABLE_SCORE_GATING=true  # 점수 게이팅 (모든 문서 점수 미달 시 문서근거 차단)
ENABLE_HALLUCINATION_CHECK=true  # 환각 감지 (출처 없는 사실 주장 탐지)
LOG_QUERY_ANALYTICS=true  # 질의 분석 로깅 (mode/score/latency)

# ============================================================================
# 보안 설정 (프로덕션 필수) - 2025-10-30
# ============================================================================
# API 인증 (32자 이상 강력한 키 사용, Git 커밋 금지!)
# API_KEY=CHANGE-ME-TO-STRONG-SECRET-KEY-32CHARS-MINIMUM

# CORS 허용 도메인 (쉼표 구분, 화이트리스트)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# 레이트 리미트 (2025-12-21: H100 동시 처리 능력 활용)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=300
MAX_CONCURRENT_REQUESTS=16  # 4 → 16 (H100 배치 처리 활용)

# 네트워크 바인딩 (보안: 내부만 허용, Nginx 프록시 사용)
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=7860
STREAMLIT_HOST=127.0.0.1
# STREAMLIT_PORT는 상단에 이미 정의됨

# ========================================
# RAG 시스템 안전 모드 설정 (2025-10-25)
# ========================================
USE_MULTILEVEL_FILTER=0
USE_RERANKER=0
USE_QUERY_EXPANSION=0
USE_DOCUMENT_COMPRESSION=0
MIN_TOP_K=3
DIAG_RAG=1

# ========================================
# 체감 품질 향상 파라미터 (2025-10-25 후속 조치)
# ========================================
DEFAULT_TOP_K=10            # 기본 검색 결과 개수
SNIPPET_MINLEN=200          # snippet 최소 길이 (200자)
SEARCH_BM25_WEIGHT=0.85     # BM25 가중치 (한글 키워드 중심)
SEARCH_VECTOR_WEIGHT=0.15   # Vector 가중치 (의미 보완)

# ============================================================================
# LIST 모드 표시 제한 (2025-10-31)
# ============================================================================
LIST_DEFAULT_LIMIT=20          # 기본 목록 표시 개수
LIST_MAX_LIMIT=200             # 최대 목록 표시 개수 ("전부" 키워드 시)
SOURCES_MAX_DISPLAY=20         # 출처 문서 최대 표시 개수

# ============================================================================
# 검색/카운트 소스 단일화 (2025-10-31 핫픽스: 0건 표시 버그 해결)
# ============================================================================
INDEX_SOURCE=metadata          # bm25, metadata 중 metadata 강제 (UI 카운트용)
UI_USE_BM25=false              # UI가 bm25_index.pkl 로드 금지

# ============================================================================
# Alerts Configuration (Index Hygiene Monitoring)
# ============================================================================
# DRY_RUN: true=콘솔 로그만, false=실제 Slack 전송
# 프로덕션에서는 false로 설정하고 SLACK_WEBHOOK_URL 입력 필요
ALERTS_DRY_RUN=true

# Slack Incoming Webhook URL (https://api.slack.com/messaging/webhooks)
# 형식: https://hooks.slack.com/services/T.../B.../xxx
# 보안: Git 커밋 금지, 환경변수로 관리 권장
SLACK_WEBHOOK_URL=

# 알림 설정 (선택적)
# ALERT_TIMEOUT_SEC=5           # 전송 타임아웃 (초)
# ALERT_MAX_RETRIES=3           # 최대 재시도 횟수
# SERVICE_NAME=ai-chat-rag      # 알림에 표시될 서비스명
# ENV=dev                       # 환경 표시 (dev/staging/prod)
LOW_CONF_DELTA=0.05          # Score delta threshold (초기: 0.05, 모니터링 후 0.07까지 상향 검토)
LOW_CONF_MIN_HITS=1           # Minimum hits required for confidence check
LOW_CONF_LIST_SIZE=20         # LIST_FIRST 모드에서 표시할 문서 개수
FINANCE_TOLERANCE_PCT=0.05    # ±5% 허용 오차 (unit_price×qty vs amount 등)
OCR_MIN_AVG_CHARS_PER_PAGE=300  # 페이지당 평균 글자수 임계값 (이미 ingest_from_docs.py에 반영됨)
